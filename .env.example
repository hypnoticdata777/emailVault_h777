# Placeholders only. Do not commit real secrets.
EMAIL_VAULT_ENV=local
EMAIL_VAULT_STORAGE_ROOT=.local/email-vault-storage
EMAIL_VAULT_MAX_ATTACHMENTS=10
EMAIL_VAULT_MAX_ATTACHMENT_BYTES=10485760
EMAIL_VAULT_MAX_TOTAL_PAYLOAD_BYTES=26214400
EMAIL_VAULT_ALLOWED_ATTACHMENT_TYPES=application/pdf,text/plain,text/csv,image/jpeg,image/png
EMAIL_VAULT_ALLOWED_ATTACHMENT_EXTENSIONS=.pdf,.txt,.csv,.jpg,.jpeg,.png
EMAIL_VAULT_IDENTITY_VERIFIER=synthetic
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=
EMAIL_VAULT_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/oauth/google/callback
EMAIL_VAULT_GMAIL_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.readonly
EMAIL_VAULT_TOKEN_STORE_PATH=.local/email-vault-token-store.json
EMAIL_VAULT_TOKEN_ENCRYPTION_KEY=
EMAIL_VAULT_ADDON_SIGNING_SECRET=
EMAIL_VAULT_ADDON_SIGNATURE_MAX_AGE_SECONDS=300
DATABASE_URL=sqlite:///./email_vault.db
EMAIL_VAULT_WEB_SESSION_SECRET=
EMAIL_VAULT_ADMIN_PASSWORD=
